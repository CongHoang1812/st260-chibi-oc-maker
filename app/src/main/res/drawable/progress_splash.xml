<?xml version="1.0" encoding="utf-8"?>
<!-- Thanh loading Splash: Figma không có, dựng từ token (rãnh trắng mờ, phần chạy cam, viền nâu) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape>
            <solid android:color="@color/splash_track" />
            <stroke android:width="@dimen/stroke_thin" android:color="@color/brown_dark" />
            <corners android:radius="@dimen/radius_medium" />
        </shape>
    </item>
    <item
        android:id="@android:id/progress"
        android:bottom="@dimen/splash_progress_inset"
        android:left="@dimen/splash_progress_inset"
        android:right="@dimen/splash_progress_inset"
        android:top="@dimen/splash_progress_inset">
        <clip android:clipOrientation="horizontal">
            <shape>
                <solid android:color="@color/orange_button" />
                <corners android:radius="@dimen/radius_small" />
            </shape>
        </clip>
    </item>
</layer-list>
