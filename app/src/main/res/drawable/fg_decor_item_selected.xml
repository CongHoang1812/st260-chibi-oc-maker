<?xml version="1.0" encoding="utf-8"?>
<!-- Viền cam 2dp (Figma 2:1219) vẽ CHỒNG lên ô editor đang chọn (ô màu / ảnh phủ kín nền) -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape>
            <stroke android:width="@dimen/cell_stroke_selected" android:color="@color/orange_selected" />
            <corners android:radius="@dimen/radius_medium" />
        </shape>
    </item>
    <item android:drawable="@color/transparent" />
</selector>
