<?xml version="1.0" encoding="utf-8"?>
<!-- Tab tiêu đề dialog (Figma 2:453 / 258:31): lõi cam bo 12 viền #803600, bóng trong đáy 3dp, đốm sáng góc trái.
     Cùng hình với nền WoodButtonDrawable.orange(ringWidth = 0) mà PaperDialogContainer vẽ bằng code. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <solid android:color="@color/button_shade" />
            <stroke android:width="@dimen/stroke_thin" android:color="@color/button_inner_stroke" />
            <corners android:radius="@dimen/radius_large" />
        </shape>
    </item>
    <item
        android:bottom="@dimen/dialog_title_tab_shade"
        android:left="@dimen/stroke_thin"
        android:right="@dimen/stroke_thin"
        android:top="@dimen/stroke_thin">
        <shape>
            <solid android:color="@color/orange_button" />
            <corners android:radius="@dimen/dialog_title_tab_inner_radius" />
        </shape>
    </item>
    <item
        android:width="@dimen/wood_button_highlight_w"
        android:height="@dimen/wood_button_highlight_h"
        android:gravity="top|start"
        android:left="@dimen/wood_button_highlight_x"
        android:top="@dimen/wood_button_highlight_y">
        <shape android:shape="oval">
            <solid android:color="@color/button_highlight_dot" />
        </shape>
    </item>
</layer-list>
