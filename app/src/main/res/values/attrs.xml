<?xml version="1.0" encoding="utf-8"?>
<resources>
    <declare-styleable name="OutlinedTextView">
        <attr name="textOutlineColor" format="color" />
        <!-- Độ dày viền tính từ đường bao chữ ra ngoài (Figma stroke Outside) -->
        <attr name="textOutlineWidth" format="dimension" />
        <attr name="textOutlineShadowColor" format="color" />
        <!-- Độ lệch hai bóng cứng: (+x, +y) và (-x, +y) -->
        <attr name="textOutlineShadowOffset" format="dimension" />
    </declare-styleable>

    <declare-styleable name="WoodButton">
        <attr name="android:text" />
        <!-- orange (mặc định) | gray (tab không chọn) | blue / red (panel Move, Figma 2:945) -->
        <attr name="variant" format="enum">
            <enum name="orange" value="0" />
            <enum name="gray" value="1" />
            <enum name="blue" value="2" />
            <enum name="red" value="3" />
            <enum name="telegram" value="4" />
            <enum name="whatsapp" value="5" />
        </attr>
        <!-- Chiều rộng cố định của nút (bỏ trống = wrap_content theo chữ) -->
        <attr name="buttonWidth" format="dimension" />
        <!-- Độ dày viền chữ (bỏ trống = wood_button_text_stroke, 0dp = không viền) -->
        <attr name="woodTextStroke" format="dimension" />
    </declare-styleable>

    <declare-styleable name="RoundIconButton">
        <!-- Glyph đặt giữa nút (icon_button_glyph_large với nút ≥ icon_button_large, nhỏ hơn thì icon_button_glyph) -->
        <attr name="icon" />
        <!-- Màu nền nút, cùng bộ với WoodButton (mặc định orange) -->
        <attr name="variant" />
        <!-- Cỡ glyph cố định (vd. mũi tên panel Move 48dp); bỏ trống = theo cỡ nút như trên -->
        <attr name="iconSize" format="dimension" />
    </declare-styleable>

    <declare-styleable name="ShimmerFrameLayout">
        <!-- dark: skeleton trắng mờ trên nền tối | light: skeleton be trên nền sáng -->
        <attr name="shimmerTone" format="enum">
            <enum name="dark" value="0" />
            <enum name="light" value="1" />
        </attr>
        <attr name="shimmerAutoStart" format="boolean" />
    </declare-styleable>

    <declare-styleable name="SkeletonView">
        <attr name="skeletonShape" format="enum">
            <enum name="rect" value="0" />
            <enum name="oval" value="1" />
            <enum name="topRounded" value="2" />
        </attr>
        <attr name="skeletonRadius" format="dimension" />
        <!-- Drawable làm khuôn (lấy theo kênh alpha), vd. khung giấy rách -->
        <attr name="skeletonMask" format="reference" />
    </declare-styleable>

    <declare-styleable name="PaperDialogContainer">
        <attr name="dialogTitle" format="string" />
        <attr name="dialogMessage" format="string" />
        <attr name="startText" format="string" />
        <attr name="endText" format="string" />
    </declare-styleable>
</resources>
