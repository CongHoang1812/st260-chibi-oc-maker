<?xml version="1.0" encoding="utf-8"?>
<!-- Typography & widget style theo docs/prompts/02_DESIGN_SYSTEM.md -->
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- ===== TextAppearance ===== -->
    <style name="Text" parent="TextAppearance.AppCompat">
        <item name="android:fontFamily">@font/app_font</item>
        <item name="fontFamily">@font/app_font</item>
        <item name="android:textColor">@color/brown_dark</item>
    </style>

    <!-- 48sp, chữ trắng viền đen (thay ảnh logo, xem docs/assets.md) -->
    <style name="Text.Logo">
        <item name="android:textSize">@dimen/text_48</item>
        <item name="android:lineHeight" tools:targetApi="28">@dimen/line_48</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:shadowColor">@android:color/black</item>
        <item name="android:shadowDx">1.6</item>
        <item name="android:shadowDy">1.6</item>
        <item name="android:shadowRadius">0.01</item>
    </style>

    <style name="Text.Title">
        <item name="android:textSize">@dimen/text_32</item>
        <item name="android:lineHeight" tools:targetApi="28">@dimen/line_48</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="Text.DialogTitle">
        <item name="android:textSize">@dimen/text_24</item>
        <item name="android:lineHeight" tools:targetApi="28">@dimen/line_32</item>
        <item name="android:textColor">@color/brown_primary</item>
    </style>

    <style name="Text.Button">
        <item name="android:textSize">@dimen/text_16</item>
        <item name="android:lineHeight" tools:targetApi="28">@dimen/line_20</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="Text.Body">
        <item name="android:textSize">@dimen/text_16</item>
        <item name="android:lineHeight" tools:targetApi="28">@dimen/line_24</item>
    </style>

    <style name="Text.Body.White">
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="Text.Body.Orange">
        <item name="android:textColor">@color/orange_selected</item>
    </style>

    <style name="Text.TabSmall">
        <item name="android:textSize">@dimen/text_14</item>
        <item name="android:lineHeight" tools:targetApi="28">@dimen/line_16</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="Text.Caption">
        <item name="android:textSize">@dimen/text_14</item>
        <item name="android:lineHeight" tools:targetApi="28">@dimen/line_20</item>
        <item name="android:textColor">@color/text_dark</item>
    </style>

    <!-- Tiêu đề trên tab cam của dialog chung (Figma 2:453): Rammetto 16 trắng -->
    <style name="Text.DialogTitle.Tab">
        <item name="android:textSize">@dimen/text_16</item>
        <item name="android:lineHeight" tools:targetApi="28">@dimen/line_24</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <!-- Nội dung dialog (Figma 2:452 dùng Inter 14 #333 → font hệ thống) -->
    <style name="Text.DialogMessage" parent="TextAppearance.AppCompat">
        <item name="android:fontFamily">sans-serif</item>
        <item name="fontFamily">sans-serif</item>
        <item name="android:textSize">@dimen/text_14</item>
        <item name="android:lineHeight" tools:targetApi="28">@dimen/line_20</item>
        <item name="android:textColor">@color/text_dark</item>
    </style>


    <!-- Lucky Gift: tiêu đề tab (LUCKY GIFT / CONGRATULATIONS) -->
    <style name="Text.LuckyGiftTitle">
        <item name="android:textSize">@dimen/text_12</item>
        <item name="android:lineHeight" tools:targetApi="28">@dimen/line_16</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="Text.LuckyGiftStart">
        <item name="android:textSize">@dimen/text_16</item>
        <item name="android:lineHeight" tools:targetApi="28">@dimen/line_24</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/lucky_gift_start_text</item>
    </style>

    <!-- Đếm ngược dưới nút quà (Figma 21:34: Inter Medium 14 đen) -->
    <style name="Text.LuckyGiftTimer" parent="TextAppearance.AppCompat">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="fontFamily">sans-serif-medium</item>
        <item name="android:textSize">@dimen/text_14</item>
        <item name="android:lineHeight" tools:targetApi="28">@dimen/line_16</item>
        <item name="android:textColor">@color/black</item>
    </style>

    <!-- Rate us dùng Roboto (font hệ thống) -->
    <style name="Text.Rate" parent="TextAppearance.AppCompat">
        <item name="android:fontFamily">sans-serif</item>
        <item name="fontFamily">sans-serif</item>
    </style>

    <style name="Text.Rate.Title">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="fontFamily">sans-serif-medium</item>
        <item name="android:textSize">@dimen/text_18</item>
        <item name="android:lineHeight" tools:targetApi="28">@dimen/line_28</item>
        <item name="android:textColor">@color/brown_primary</item>
    </style>

    <style name="Text.Rate.Message">
        <item name="android:textSize">@dimen/text_14</item>
        <item name="android:lineHeight" tools:targetApi="28">@dimen/line_20</item>
        <item name="android:textColor">@color/brown_text_60</item>
    </style>

    <style name="Text.Rate.Button">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="fontFamily">sans-serif-medium</item>
        <item name="android:textSize">@dimen/text_16</item>
        <item name="android:lineHeight" tools:targetApi="28">@dimen/line_20</item>
    </style>

    <!-- ===== Widget ===== -->
    <style name="Widget.ST260ChibiOCMaker.TextView" parent="Widget.AppCompat.TextView">
        <item name="android:fontFamily">@font/app_font</item>
        <item name="fontFamily">@font/app_font</item>
    </style>

    <!-- Icon 40dp đã gồm sẵn nền nút (ic_back, ic_settings, ic_download, ic_archive, ic_info, ic_close…) -->
    <!-- Ô ảnh chờ (com.facebook.shimmer): nền be + dải sáng trắng nghiêng -->
    <style name="Widget.ST260ChibiOCMaker.Shimmer" parent="">
        <item name="shimmer_auto_start">true</item>
        <item name="shimmer_base_alpha">1</item>
        <item name="shimmer_base_color">@color/shimmer_base_light</item>
        <item name="shimmer_colored">true</item>
        <item name="shimmer_direction">left_to_right</item>
        <item name="shimmer_dropoff">0.3</item>
        <item name="shimmer_duration">1200</item>
        <item name="shimmer_highlight_alpha">1</item>
        <item name="shimmer_highlight_color">@color/white</item>
        <item name="shimmer_intensity">0.1</item>
        <item name="shimmer_repeat_delay">300</item>
        <item name="shimmer_tilt">20</item>
    </style>

    <style name="Widget.ST260ChibiOCMaker.ImageIconButton" parent="">
        <item name="android:layout_width">@dimen/icon_button_large</item>
        <item name="android:layout_height">@dimen/icon_button_large</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:stateListAnimator">@animator/press_scale</item>
        <item name="android:padding">0dp</item>
    </style>

    <style name="Widget.ST260ChibiOCMaker.WoodButton" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">@dimen/wood_button_height</item>
    </style>

    <!-- Nút chữ panel Move (RESET / EXIT, Figma 2:969): 120×56, chữ in hoa tự co khi bản dịch dài -->
    <style name="Widget.ST260ChibiOCMaker.MoveTextButton" parent="Widget.ST260ChibiOCMaker.WoodButton">
        <item name="android:layout_height">@dimen/move_button</item>
        <item name="buttonWidth">@dimen/move_text_button_w</item>
        <item name="android:textAllCaps">true</item>
        <item name="autoSizeTextType">uniform</item>
        <item name="autoSizeMinTextSize">@dimen/move_text_min</item>
        <item name="autoSizeMaxTextSize">@dimen/text_16</item>
    </style>

    <!-- Nút icon xanh panel Move (Figma 2:950): 56, cách nút trước 8 -->
    <style name="Widget.ST260ChibiOCMaker.MoveIconButton" parent="">
        <item name="android:layout_width">@dimen/move_button</item>
        <item name="android:layout_height">@dimen/move_button</item>
        <item name="android:layout_marginStart">@dimen/move_button_gap</item>
        <item name="variant">blue</item>
    </style>

    <!-- Chữ nhỏ ở splash (Figma dùng Inter -> font hệ thống) -->
    <style name="Text.SplashInfo" parent="TextAppearance.AppCompat">
        <item name="android:fontFamily">sans-serif</item>
        <item name="fontFamily">sans-serif</item>
        <item name="android:textSize">@dimen/text_12</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="ShapeAppearance.ST260ChibiOCMaker.DecorItem" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/decor_item_radius</item>
    </style>

    <style name="ShapeAppearance.ST260ChibiOCMaker.Circle" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!-- Hàng trắng viền nâu bo 16 (language / setting / permission) -->
    <style name="Widget.ST260ChibiOCMaker.ListRow" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/language_item_h</item>
        <item name="android:background">@drawable/bg_language_item</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingStart">@dimen/language_item_padding_h</item>
        <item name="android:paddingEnd">@dimen/language_item_padding_h</item>
    </style>

    <!-- Nhãn thẻ Home (Figma 2:1013: Rammetto 16 trắng in hoa, dòng 16) -->
    <style name="Text.HomeCard">
        <item name="android:textSize">@dimen/text_16</item>
        <item name="android:lineHeight" tools:targetApi="28">@dimen/line_16</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <!-- Nhãn ở đáy thẻ Home: tự xuống dòng ở khoảng trắng như Figma (CHIBI OC / MAKER) -->
    <style name="Widget.ST260ChibiOCMaker.HomeCardLabel" parent="Widget.ST260ChibiOCMaker.TextView">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_gravity">bottom|center_horizontal</item>
        <item name="android:layout_marginBottom">@dimen/home_card_label_bottom</item>
        <item name="android:layout_marginStart">@dimen/home_card_label_h</item>
        <item name="android:layout_marginEnd">@dimen/home_card_label_h</item>
        <item name="android:gravity">center</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:maxLines">2</item>
        <item name="android:ellipsize">end</item>
        <item name="android:textAppearance">@style/Text.HomeCard</item>
    </style>

    <style name="Widget.ST260ChibiOCMaker.HomeCard" parent="Widget.Material3.CardView.Filled">
        <item name="android:layout_width">@dimen/home_card_size</item>
        <item name="android:layout_height">@dimen/home_card_size</item>
        <item name="cardCornerRadius">@dimen/home_card_radius</item>
        <item name="cardElevation">0dp</item>
        <item name="cardBackgroundColor">@color/transparent</item>
        <item name="strokeColor">@color/white</item>
        <item name="strokeWidth">@dimen/stroke_thin</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>
</resources>
