<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. App chỉ có light mode (khoá trong ST260ChibiOCMakerApp). -->
    <style name="Base.Theme.ST260ChibiOCMaker" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brown_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/orange_button</item>
        <item name="colorSurface">@color/cream</item>
        <item name="colorOnSurface">@color/brown_dark</item>
        <item name="android:colorBackground">@color/cream</item>
        <item name="android:windowBackground">@color/language_bg</item>

        <item name="android:fontFamily">@font/app_font</item>
        <item name="fontFamily">@font/app_font</item>
        <item name="android:textAppearance">@style/Text.Body</item>
        <item name="android:textViewStyle">@style/Widget.ST260ChibiOCMaker.TextView</item>

        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
    </style>

    <style name="Theme.ST260ChibiOCMaker" parent="Base.Theme.ST260ChibiOCMaker" />

    <!-- Dialog nền trong suốt, dim 0.5 (Figma 2:444), không title (nội dung tự vẽ bằng PaperDialogContainer) -->
    <style name="Theme.ST260ChibiOCMaker.Dialog" parent="Theme.Material3.Light.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.5</item>
        <item name="android:windowMinWidthMajor">0dp</item>
        <item name="android:windowMinWidthMinor">0dp</item>
        <item name="android:fontFamily">@font/app_font</item>
        <item name="fontFamily">@font/app_font</item>
        <item name="android:textViewStyle">@style/Widget.ST260ChibiOCMaker.TextView</item>
    </style>

    <!--
        Splash hệ thống (core-splashscreen, Android 12+ luôn hiện, không tắt được), sau đó chuyển sang
        Theme.ST260ChibiOCMaker. Không icon + màu nền trùng tông đầu ảnh splash (Figma 2:1091) → trông như
        một màn splash duy nhất thay vì 2 màn nối nhau.
    -->
    <style name="Theme.ST260ChibiOCMaker.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@android:color/transparent</item>
        <item name="postSplashScreenTheme">@style/Theme.ST260ChibiOCMaker</item>
    </style>
</resources>
