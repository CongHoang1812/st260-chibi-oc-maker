<?xml version="1.0" encoding="utf-8"?>
<!-- Home (Figma 2:1003): nền biển, logo ảnh, 4 thẻ 160 bo 24 viền trắng, dải màu đáy thẻ + nhãn in hoa -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/img_home_bg" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false">

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guide_center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.5" />

        <!-- Logo (Figma 21:29): rộng 360, cao 135, y 128 - 44 -->
        <ImageView
            android:id="@+id/iv_logo"
            android:layout_width="0dp"
            android:layout_height="@dimen/home_logo_h"
            android:layout_marginTop="@dimen/home_logo_top"
            android:contentDescription="@string/app_title"
            android:scaleType="fitCenter"
            android:src="@drawable/img_logo"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_max="@dimen/home_logo_w" />

        <ImageButton
            android:id="@+id/btn_settings"
            style="@style/Widget.ST260ChibiOCMaker.ImageIconButton"
            android:layout_marginEnd="@dimen/screen_padding"
            android:layout_marginTop="@dimen/top_bar_top"
            android:contentDescription="@string/cd_settings"
            android:src="@drawable/ic_settings"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_maker"
            style="@style/Widget.ST260ChibiOCMaker.HomeCard"
            android:layout_marginEnd="@dimen/home_card_half_gap"
            android:layout_marginTop="@dimen/home_cards_top"
            app:layout_constraintEnd_toStartOf="@id/guide_center"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop"
                android:src="@drawable/img_home_maker" />

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_home_card_fade_maker" />

            <TextView
                style="@style/Widget.ST260ChibiOCMaker.HomeCardLabel"
                android:text="@string/home_maker" />
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_cosplay"
            style="@style/Widget.ST260ChibiOCMaker.HomeCard"
            android:layout_marginStart="@dimen/home_card_half_gap"
            android:layout_marginTop="@dimen/home_cards_top"
            app:layout_constraintStart_toEndOf="@id/guide_center"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop"
                android:src="@drawable/img_home_cosplay" />

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_home_card_fade_cosplay" />

            <TextView
                style="@style/Widget.ST260ChibiOCMaker.HomeCardLabel"
                android:text="@string/home_cosplay" />
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_lucky"
            style="@style/Widget.ST260ChibiOCMaker.HomeCard"
            android:layout_marginEnd="@dimen/home_card_half_gap"
            android:layout_marginTop="@dimen/home_card_gap"
            app:layout_constraintEnd_toStartOf="@id/guide_center"
            app:layout_constraintTop_toBottomOf="@id/card_maker">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop"
                android:src="@drawable/img_home_lucky" />

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_home_card_fade_lucky" />

            <TextView
                style="@style/Widget.ST260ChibiOCMaker.HomeCardLabel"
                android:text="@string/home_lucky_roll" />
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_creation"
            style="@style/Widget.ST260ChibiOCMaker.HomeCard"
            android:layout_marginStart="@dimen/home_card_half_gap"
            android:layout_marginTop="@dimen/home_card_gap"
            app:layout_constraintStart_toEndOf="@id/guide_center"
            app:layout_constraintTop_toBottomOf="@id/card_cosplay">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop"
                android:src="@drawable/img_home_creation" />

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_home_card_fade_creation" />

            <TextView
                style="@style/Widget.ST260ChibiOCMaker.HomeCardLabel"
                android:text="@string/home_my_creation" />
        </com.google.android.material.card.MaterialCardView>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
