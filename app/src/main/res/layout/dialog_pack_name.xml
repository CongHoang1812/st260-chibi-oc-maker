<?xml version="1.0" encoding="utf-8"?>
<!-- Create Package Name: đặt tên gói sticker trước khi thêm vào WhatsApp.
     Figma chưa có frame: dựng theo khung dialog chung (258:18), ô nhập giống ô nhập chữ của Decor editor (2:1454). -->
<com.chibi.dream.cute.core.widget.PaperDialogContainer xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/container"
    android:layout_width="@dimen/dialog_width"
    android:layout_height="wrap_content"
    app:dialogTitle="@string/create_pack_name_title"
    app:endText="@string/no"
    app:startText="@string/yes">

    <EditText
        android:id="@+id/et_pack_name"
        android:layout_width="@dimen/dialog_text_width"
        android:layout_height="@dimen/editor_input_h"
        android:autofillHints=""
        android:background="@drawable/bg_text_input"
        android:fontFamily="sans-serif"
        android:hint="@string/pack_name_hint"
        android:imeOptions="actionDone"
        android:importantForAutofill="no"
        android:inputType="textCapSentences"
        android:maxLength="@integer/pack_name_max_length"
        android:maxLines="1"
        android:paddingHorizontal="@dimen/radius_large"
        android:textAppearance="@style/Text.DialogMessage"
        android:textColorHint="@color/hint_gray" />
</com.chibi.dream.cute.core.widget.PaperDialogContainer>
