<?xml version="1.0" encoding="utf-8"?>
<!-- Successful (Figma Maker 2:1421, Cosplay 2:280; thẻ điểm sao 2:321 / 2:330).
     MAKER: ảnh vuông trắng rộng hết màn trên nền gradient chung.
     COSPLAY: nền cam (đặt trong code), tia sáng + thẻ polaroid có băng dính, ảnh 208 và 3 sao trong thẻ. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_tavern"
    tools:ignore="Overdraw">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Vùng ảnh kết quả vuông (Figma 2:1439 / 2:281): mốc cho ảnh Maker và thẻ Cosplay -->
        <Space
            android:id="@+id/result_area"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/success_image_top"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_max="@dimen/success_image_max" />

        <!-- ===== Trang trí Cosplay (ẩn ở Maker) ===== -->
        <ImageView
            android:id="@+id/iv_burst"
            android:layout_width="@dimen/success_burst"
            android:layout_height="@dimen/success_burst"
            android:importantForAccessibility="no"
            android:src="@drawable/img_success_burst"
            app:layout_constraintBottom_toBottomOf="@id/result_area"
            app:layout_constraintEnd_toEndOf="@id/result_area"
            app:layout_constraintStart_toStartOf="@id/result_area"
            app:layout_constraintTop_toTopOf="@id/result_area" />

        <!-- Thẻ 240×288 + 4dp bóng ở đáy; margin trên 4 để phần thẻ nằm giữa vùng ảnh -->
        <View
            android:id="@+id/cosplay_card"
            android:layout_width="@dimen/success_card_w"
            android:layout_height="@dimen/success_card_h_with_shadow"
            android:layout_marginTop="@dimen/success_card_shadow"
            android:background="@drawable/bg_success_card"
            app:layout_constraintBottom_toBottomOf="@id/result_area"
            app:layout_constraintEnd_toEndOf="@id/result_area"
            app:layout_constraintStart_toStartOf="@id/result_area"
            app:layout_constraintTop_toTopOf="@id/result_area" />

        <!-- Ảnh kết quả. MAKER: phủ kín vùng ảnh, nền trắng. COSPLAY: code đổi thành ô 208 trong thẻ. -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/iv_result"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@color/white"
            android:contentDescription="@string/cd_result_image"
            android:scaleType="fitCenter"
            app:layout_constraintBottom_toBottomOf="@id/result_area"
            app:layout_constraintEnd_toEndOf="@id/result_area"
            app:layout_constraintStart_toStartOf="@id/result_area"
            app:layout_constraintTop_toTopOf="@id/result_area" />

        <ImageView
            android:id="@+id/iv_tape_top"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/success_tape_inset"
            android:layout_marginTop="@dimen/success_tape_inset"
            android:importantForAccessibility="no"
            android:src="@drawable/img_success_tape_top"
            app:layout_constraintStart_toStartOf="@id/cosplay_card"
            app:layout_constraintTop_toTopOf="@id/cosplay_card" />

        <!-- Figma 2:288: góc phải dưới ảnh, x 186 / y 195 trong thẻ -->
        <ImageView
            android:id="@+id/iv_tape_bottom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/success_tape_inset"
            android:layout_marginTop="@dimen/success_tape_bottom_top"
            android:importantForAccessibility="no"
            android:src="@drawable/img_success_tape_bottom"
            app:layout_constraintEnd_toEndOf="@id/cosplay_card"
            app:layout_constraintTop_toTopOf="@id/cosplay_card" />

        <androidx.constraintlayout.widget.Group
            android:id="@+id/cosplay_decor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:constraint_referenced_ids="iv_burst,cosplay_card,iv_tape_top,iv_tape_bottom"
            tools:visibility="visible" />

        <!-- 3 sao (chỉ COSPLAY), trong thẻ cách đỉnh 234 -->
        <LinearLayout
            android:id="@+id/star_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/success_stars_top"
            android:orientation="horizontal"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="@id/cosplay_card"
            app:layout_constraintStart_toStartOf="@id/cosplay_card"
            app:layout_constraintTop_toTopOf="@id/cosplay_card"
            tools:visibility="visible">

            <ImageView
                android:id="@+id/iv_star_1"
                android:layout_width="@dimen/success_star_small"
                android:layout_height="@dimen/success_star_small"
                android:importantForAccessibility="no"
                android:src="@drawable/img_star_off" />

            <ImageView
                android:id="@+id/iv_star_2"
                android:layout_width="@dimen/success_star_big"
                android:layout_height="@dimen/success_star_big"
                android:layout_marginHorizontal="@dimen/success_star_gap"
                android:importantForAccessibility="no"
                android:src="@drawable/img_star_off" />

            <ImageView
                android:id="@+id/iv_star_3"
                android:layout_width="@dimen/success_star_small"
                android:layout_height="@dimen/success_star_small"
                android:importantForAccessibility="no"
                android:src="@drawable/img_star_off" />
        </LinearLayout>

        <!-- Top bar: re-edit | share, my creation, home (Figma 2:1440, 2:1446, 2:1430, 2:1422) -->
        <com.conght.chibiocmaker.core.widget.RoundIconButton
            android:id="@+id/btn_re_edit"
            android:layout_width="@dimen/icon_button_large"
            android:layout_height="@dimen/icon_button_large"
            android:layout_marginStart="@dimen/screen_padding"
            android:layout_marginTop="@dimen/top_bar_top"
            android:contentDescription="@string/cd_re_edit"
            app:icon="@drawable/ic_rotate_right"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <com.conght.chibiocmaker.core.widget.RoundIconButton
            android:id="@+id/btn_home"
            android:layout_width="@dimen/icon_button_large"
            android:layout_height="@dimen/icon_button_large"
            android:layout_marginEnd="@dimen/screen_padding"
            android:layout_marginTop="@dimen/top_bar_top"
            android:contentDescription="@string/cd_home"
            app:icon="@drawable/ic_home"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageButton
            android:id="@+id/btn_my_creation"
            style="@style/Widget.ST260ChibiOCMaker.ImageIconButton"
            android:layout_marginEnd="@dimen/success_action_gap"
            android:contentDescription="@string/cd_my_creation"
            android:src="@drawable/ic_archive"
            app:layout_constraintEnd_toStartOf="@id/btn_home"
            app:layout_constraintTop_toTopOf="@id/btn_home" />

        <com.conght.chibiocmaker.core.widget.RoundIconButton
            android:id="@+id/btn_share"
            android:layout_width="@dimen/icon_button_large"
            android:layout_height="@dimen/icon_button_large"
            android:layout_marginEnd="@dimen/success_action_gap"
            android:contentDescription="@string/cd_share"
            app:icon="@drawable/ic_share"
            app:layout_constraintEnd_toStartOf="@id/btn_my_creation"
            app:layout_constraintTop_toTopOf="@id/btn_home" />

        <!-- Download rộng 328, cách vùng ảnh 24 (Figma 2:1435) -->
        <com.conght.chibiocmaker.core.widget.WoodButton
            android:id="@+id/btn_download"
            style="@style/Widget.ST260ChibiOCMaker.WoodButton"
            android:layout_marginTop="@dimen/success_download_top"
            android:text="@string/download"
            app:buttonWidth="@dimen/success_download_w"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/result_area" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
