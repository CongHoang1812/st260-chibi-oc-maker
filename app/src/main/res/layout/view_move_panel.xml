<?xml version="1.0" encoding="utf-8"?>
<!-- Panel chế độ Move (Figma 2:945): 2 hàng nút xanh 56, cách đỉnh 24, khe 8.
     Hàng 1: RESET (bộ phận đang chọn) | xoay trái | lên | xoay phải
     Hàng 2: EXIT                      | trái      | xuống | phải
     Không có nút zoom (Figma): zoom bằng hai ngón tay trên nhân vật. -->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:orientation="vertical"
    tools:parentTag="android.widget.LinearLayout">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/move_panel_top"
        android:orientation="horizontal">

        <com.chibi.dream.cute.core.widget.WoodButton
            android:id="@+id/btn_reset_part"
            style="@style/Widget.ST260ChibiOCMaker.MoveTextButton"
            android:text="@string/move_reset"
            app:variant="blue" />

        <com.chibi.dream.cute.core.widget.RoundIconButton
            android:id="@+id/btn_rotate_left"
            style="@style/Widget.ST260ChibiOCMaker.MoveIconButton"
            android:contentDescription="@string/cd_rotate_left"
            app:icon="@drawable/ic_rotate_left" />

        <com.chibi.dream.cute.core.widget.RoundIconButton
            android:id="@+id/btn_up"
            style="@style/Widget.ST260ChibiOCMaker.MoveIconButton"
            android:contentDescription="@string/cd_move_up"
            app:icon="@drawable/ic_arrow_up"
            app:iconSize="@dimen/move_arrow_glyph" />

        <com.chibi.dream.cute.core.widget.RoundIconButton
            android:id="@+id/btn_rotate_right"
            style="@style/Widget.ST260ChibiOCMaker.MoveIconButton"
            android:contentDescription="@string/cd_rotate_right"
            app:icon="@drawable/ic_rotate_right_button" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/move_button_gap"
        android:orientation="horizontal">

        <com.chibi.dream.cute.core.widget.WoodButton
            android:id="@+id/btn_exit"
            style="@style/Widget.ST260ChibiOCMaker.MoveTextButton"
            android:text="@string/exit"
            app:variant="red" />

        <com.chibi.dream.cute.core.widget.RoundIconButton
            android:id="@+id/btn_left"
            style="@style/Widget.ST260ChibiOCMaker.MoveIconButton"
            android:contentDescription="@string/cd_move_left"
            app:icon="@drawable/ic_arrow_left"
            app:iconSize="@dimen/move_arrow_glyph" />

        <com.chibi.dream.cute.core.widget.RoundIconButton
            android:id="@+id/btn_down"
            style="@style/Widget.ST260ChibiOCMaker.MoveIconButton"
            android:contentDescription="@string/cd_move_down"
            app:icon="@drawable/ic_arrow_down"
            app:iconSize="@dimen/move_arrow_glyph" />

        <com.chibi.dream.cute.core.widget.RoundIconButton
            android:id="@+id/btn_right"
            style="@style/Widget.ST260ChibiOCMaker.MoveIconButton"
            android:contentDescription="@string/cd_move_right"
            app:icon="@drawable/ic_arrow_right"
            app:iconSize="@dimen/move_arrow_glyph" />
    </LinearLayout>
</merge>
