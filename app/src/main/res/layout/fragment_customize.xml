<?xml version="1.0" encoding="utf-8"?>
<!-- Maker – Customize (Figma 2:469) + Move (2:931). Cả màn nằm trong 1 ShimmerFrameLayout để
     mọi skeleton (canvas, màu, lưới, tab) quét đồng bộ; ô None / Xúc xắc là view thật nên không bị phủ. -->
<com.conght.chibiocmaker.core.widget.ShimmerFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/shimmer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/customize_canvas_bg"
    app:shimmerAutoStart="false"
    app:shimmerTone="light">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Mốc hàng công cụ (Figma y 480): ngay trên panel, cách 16. Luôn có mặt (kể cả Cosplay ẩn nút)
             để canvas không đổi kích thước theo việc ẩn / hiện nút. -->
        <Space
            android:id="@+id/tools_row"
            android:layout_width="0dp"
            android:layout_height="@dimen/icon_button"
            android:layout_marginBottom="@dimen/customize_tools_bottom"
            app:layout_constraintBottom_toTopOf="@id/panel"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Canvas nhân vật rộng tối đa 352, từ dưới top bar tới trên hàng công cụ -->
        <com.conght.chibiocmaker.core.widget.CharacterCanvasView
            android:id="@+id/canvas"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/content_top"
            android:layout_marginBottom="@dimen/grid_gap"
            android:visibility="invisible"
            app:layout_constraintBottom_toTopOf="@id/tools_row"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_max="@dimen/character_size_large" />

        <include
            android:id="@+id/canvas_skeleton"
            layout="@layout/view_skeleton_image"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginBottom="@dimen/grid_gap"
            android:layout_marginTop="@dimen/content_top"
            app:layout_constraintBottom_toTopOf="@id/tools_row"
            app:layout_constraintWidth_max="@dimen/character_size_large"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <com.conght.chibiocmaker.core.widget.ErrorStateView
            android:id="@+id/error_state"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@id/canvas_skeleton"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/canvas_skeleton" />

        <!-- Top bar -->
        <ImageButton
            android:id="@+id/btn_back"
            style="@style/Widget.ST260ChibiOCMaker.ImageIconButton"
            android:layout_marginStart="@dimen/screen_padding"
            android:layout_marginTop="@dimen/top_bar_top"
            android:contentDescription="@string/cd_back"
            android:src="@drawable/ic_home_button"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <com.conght.chibiocmaker.core.widget.WoodButton
            android:id="@+id/btn_next"
            style="@style/Widget.ST260ChibiOCMaker.WoodButton"
            android:layout_marginEnd="@dimen/screen_padding"
            android:layout_marginTop="@dimen/top_bar_top"
            android:text="@string/next"
            android:textAllCaps="true"
            app:buttonWidth="@dimen/next_button_w"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Lucky Gift: nút quà dưới Next (Figma 2:628) + chấm đỏ khi quay được + đếm ngược (2:886) -->
        <FrameLayout
            android:id="@+id/lucky_gift"
            android:layout_width="@dimen/lucky_gift_button"
            android:layout_height="@dimen/lucky_gift_button"
            android:layout_marginTop="@dimen/lucky_gift_button_top"
            android:layout_marginEnd="@dimen/screen_padding"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:visibility="visible">

            <ImageButton
                android:id="@+id/btn_lucky_gift"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_lucky_gift_button"
                android:contentDescription="@string/cd_lucky_gift"
                android:padding="@dimen/lucky_gift_button_padding"
                android:scaleType="fitCenter"
                android:src="@drawable/img_lucky_gift"
                android:stateListAnimator="@animator/press_scale" />

            <View
                android:id="@+id/lucky_gift_badge"
                android:layout_width="@dimen/lucky_gift_badge"
                android:layout_height="@dimen/lucky_gift_badge"
                android:layout_gravity="top|end"
                android:layout_margin="@dimen/lucky_gift_badge_margin"
                android:background="@drawable/bg_lucky_gift_badge" />
        </FrameLayout>

        <TextView
            android:id="@+id/tv_lucky_gift_timer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/Text.LuckyGiftTimer"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="@id/lucky_gift"
            app:layout_constraintStart_toStartOf="@id/lucky_gift"
            app:layout_constraintTop_toBottomOf="@id/lucky_gift"
            tools:text="30:00"
            tools:visibility="visible" />

        <!-- COSPLAY: thanh thời gian giữa top bar (Figma 3:134) -->
        <LinearLayout
            android:id="@+id/timer_bar"
            android:layout_width="@dimen/cosplay_timer_w"
            android:layout_height="@dimen/cosplay_timer_h"
            android:layout_marginTop="@dimen/top_bar_top"
            android:background="@drawable/bg_timer_pill"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/cosplay_timer_padding"
            android:paddingTop="@dimen/cosplay_timer_padding"
            android:paddingEnd="@dimen/cosplay_timer_padding_end"
            android:paddingBottom="@dimen/cosplay_timer_padding"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:visibility="visible">

            <TextView
                android:id="@+id/tv_timer"
                android:layout_width="@dimen/cosplay_timer_label_w"
                android:layout_height="match_parent"
                android:background="@drawable/bg_timer_label"
                android:gravity="center"
                android:textAppearance="@style/Text.Button"
                tools:text="03:00" />

            <ProgressBar
                android:id="@+id/progress_timer"
                style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                android:layout_width="0dp"
                android:layout_height="@dimen/cosplay_timer_progress_h"
                android:layout_marginStart="@dimen/cosplay_timer_padding"
                android:layout_weight="1"
                android:progressDrawable="@drawable/progress_timer" />
        </LinearLayout>

        <!-- COSPLAY: thumbnail ảnh tham chiếu góc phải dưới canvas (Figma 3:139) -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/iv_reference"
            android:layout_width="@dimen/cosplay_reference"
            android:layout_height="@dimen/cosplay_reference"
            android:layout_marginEnd="@dimen/cosplay_reference_end"
            android:layout_marginBottom="@dimen/cosplay_reference_end"
            android:background="@color/white"
            android:contentDescription="@string/cd_reference_image"
            android:padding="@dimen/stroke_thin"
            android:scaleType="centerCrop"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@id/canvas_skeleton"
            app:layout_constraintEnd_toEndOf="parent"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.ST260ChibiOCMaker.DecorItem"
            app:strokeColor="@color/white"
            app:strokeWidth="@dimen/cosplay_reference_border" />

        <!-- Hàng công cụ (Figma 2:479 / 2:485 / 2:491): reset / flip / move nằm ngang, cách nhau 12 -->
        <com.conght.chibiocmaker.core.widget.RoundIconButton
            android:id="@+id/btn_reset"
            android:layout_width="@dimen/icon_button"
            android:layout_height="@dimen/icon_button"
            android:layout_marginStart="@dimen/screen_padding"
            android:contentDescription="@string/cd_reset"
            app:icon="@drawable/ic_reset"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/tools_row" />

        <com.conght.chibiocmaker.core.widget.RoundIconButton
            android:id="@+id/btn_flip"
            android:layout_width="@dimen/icon_button"
            android:layout_height="@dimen/icon_button"
            android:layout_marginStart="@dimen/customize_tool_gap"
            android:contentDescription="@string/cd_flip"
            app:icon="@drawable/ic_flip_tool"
            app:layout_constraintStart_toEndOf="@id/btn_reset"
            app:layout_constraintTop_toTopOf="@id/tools_row" />

        <com.conght.chibiocmaker.core.widget.RoundIconButton
            android:id="@+id/btn_move"
            android:layout_width="@dimen/icon_button"
            android:layout_height="@dimen/icon_button"
            android:layout_marginStart="@dimen/customize_tool_gap"
            android:contentDescription="@string/cd_move"
            app:icon="@drawable/ic_move_tool"
            app:layout_constraintStart_toEndOf="@id/btn_flip"
            app:layout_constraintTop_toTopOf="@id/tools_row" />

        <!-- Random cả nhân vật (Figma 2:496): cuối hàng công cụ, bên phải -->
        <ImageButton
            android:id="@+id/btn_random_all"
            android:layout_width="@dimen/random_all_size"
            android:layout_height="@dimen/random_all_size"
            android:layout_marginEnd="@dimen/screen_padding"
            android:background="@drawable/bg_gift_button"
            android:contentDescription="@string/cd_random"
            android:padding="@dimen/random_all_padding"
            android:scaleType="fitCenter"
            android:src="@drawable/img_dice_gift"
            android:stateListAnimator="@animator/press_scale"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/tools_row" />

        <!-- Panel dưới -->
        <FrameLayout
            android:id="@+id/panel"
            android:layout_width="0dp"
            android:layout_height="@dimen/bottom_panel_height"
            android:background="@color/panel_brown"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/edit_panel"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <!-- Hàng chấm màu (Figma 2:529): không có nền, cách mép trái 24, đỉnh 16 -->
                <FrameLayout
                    android:id="@+id/color_bar"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/color_bar_height"
                    android:layout_marginHorizontal="@dimen/part_grid_padding_h"
                    android:layout_marginTop="@dimen/customize_panel_top"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_colors"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:overScrollMode="never"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                        tools:listitem="@layout/item_color_dot" />
                </FrameLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_parts"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_marginTop="@dimen/customize_panel_top"
                    android:clipToPadding="false"
                    android:overScrollMode="never"
                    android:paddingHorizontal="@dimen/part_grid_padding_h"
                    android:paddingBottom="@dimen/grid_gap"
                    app:layout_constraintBottom_toTopOf="@id/tabs_line"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/color_bar"
                    tools:listitem="@layout/item_part" />

                <!-- Mốc thanh tab: lưới dừng ở mép trên thanh tab -->
                <Space
                    android:id="@+id/tabs_line"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/category_tab_bar_h"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />

                <!-- Thanh tab category (Figma 2:537): nền xanh đậm, ô 40, đệm 20 / 8 -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_tabs"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/category_tab_bar_h"
                    android:background="@color/tab_bar_bg"
                    android:clipToPadding="false"
                    android:orientation="horizontal"
                    android:overScrollMode="never"
                    android:paddingHorizontal="@dimen/category_tab_bar_padding_h"
                    android:paddingVertical="@dimen/category_tab_bar_padding_v"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    tools:listitem="@layout/item_category_tab" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <com.conght.chibiocmaker.feature.maker.move.MovePanelView
                android:id="@+id/move_panel"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone" />
        </FrameLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.conght.chibiocmaker.core.widget.ShimmerFrameLayout>
