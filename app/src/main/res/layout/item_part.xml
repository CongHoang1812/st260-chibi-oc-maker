<?xml version="1.0" encoding="utf-8"?>
<!-- Ô item phụ kiện: khung giấy (chọn = trắng) + thumbnail. Part khoá (Lucky Gift): thumbnail mờ + icon khoá -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="@dimen/part_item_h"
    android:background="@drawable/bg_part_item_state"
    android:focusable="true">

    <ImageView
        android:id="@+id/iv_thumbnail"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="@dimen/grid_gap"
        android:scaleType="fitCenter"
        tools:ignore="ContentDescription" />

    <ImageView
        android:id="@+id/iv_lock"
        android:layout_width="@dimen/part_lock_icon"
        android:layout_height="@dimen/part_lock_icon"
        android:layout_gravity="top|end"
        android:layout_margin="@dimen/part_lock_margin"
        android:contentDescription="@string/cd_locked"
        android:src="@drawable/ic_lock"
        android:visibility="gone"
        tools:visibility="visible" />
</FrameLayout>
