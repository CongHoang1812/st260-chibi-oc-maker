<?xml version="1.0" encoding="utf-8"?>
<!-- Decor editor (Figma: nền ảnh 2:1182, nền màu 2:1240, sticker 2:1296, speech 2:1358, text 2:1452).
     Cả màn trong 1 ShimmerFrameLayout: pack (API) là skeleton, ô None / Color / Image / font / màu là view thật. -->
<com.chibi.dream.cute.core.widget.ShimmerFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/shimmer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_tavern"
    app:shimmerAutoStart="false"
    app:shimmerTone="light">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageButton
            android:id="@+id/btn_back"
            style="@style/Widget.ST260ChibiOCMaker.ImageIconButton"
            android:layout_marginStart="@dimen/screen_padding"
            android:layout_marginTop="@dimen/top_bar_top"
            android:contentDescription="@string/cd_back"
            android:src="@drawable/ic_back"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageButton
            android:id="@+id/btn_download"
            style="@style/Widget.ST260ChibiOCMaker.ImageIconButton"
            android:layout_marginEnd="@dimen/screen_padding"
            android:layout_marginTop="@dimen/top_bar_top"
            android:contentDescription="@string/cd_download"
            android:src="@drawable/ic_download"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Vùng thiết kế vuông rộng hết màn (Figma 2:1188), co lại khi màn thấp -->
        <com.chibi.dream.cute.feature.decor.editor.DecorCanvasView
            android:id="@+id/canvas"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginBottom="@dimen/grid_gap"
            android:layout_marginTop="@dimen/editor_canvas_top"
            android:contentDescription="@string/cd_design_canvas"
            app:layout_constraintBottom_toTopOf="@id/panel"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0" />

        <!-- Ô nhập ẩn cho bong bóng: chỉ để nhận bàn phím, chữ hiện trực tiếp trên canvas -->
        <EditText
            android:id="@+id/et_speech"
            android:layout_width="@dimen/hidden_input_size"
            android:layout_height="@dimen/hidden_input_size"
            android:alpha="0"
            android:background="@null"
            android:cursorVisible="false"
            android:imeOptions="actionDone|flagNoExtractUi"
            android:importantForAccessibility="no"
            android:importantForAutofill="no"
            android:inputType="textCapSentences"
            android:maxLines="1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:ignore="LabelFor" />

        <!-- Panel dưới: phần nội dung xanh nhạt + thanh tab chính ở đáy -->
        <LinearLayout
            android:id="@+id/panel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/editor_panel_body_h"
                android:background="@color/panel_brown"
                android:orientation="vertical"
                android:paddingTop="@dimen/editor_panel_padding_top">

                <!-- Tab con (Image / Color / pack), canh giữa như Figma 2:1222 -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_sub_tabs"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/wood_button_tab_height"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginBottom="@dimen/editor_sub_tab_bottom"
                    android:clipToPadding="false"
                    android:orientation="horizontal"
                    android:overScrollMode="never"
                    android:paddingHorizontal="@dimen/part_grid_padding_h"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tools:listitem="@layout/item_sub_tab" />

                <!-- Hàng nhập chữ (tab Text, Figma 2:1454) -->
                <LinearLayout
                    android:id="@+id/input_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/editor_input_bottom"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/part_grid_padding_h"
                    android:visibility="gone">

                    <EditText
                        android:id="@+id/et_text"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/editor_text_input_h"
                        android:layout_weight="1"
                        android:background="@drawable/bg_text_input"
                        android:hint="@string/text_hint"
                        android:imeOptions="actionDone"
                        android:importantForAutofill="no"
                        android:inputType="textCapSentences"
                        android:maxLines="1"
                        android:paddingHorizontal="@dimen/radius_large"
                        android:textColor="@color/brown_dark"
                        android:textColorHint="@color/hint_gray"
                        android:textSize="@dimen/editor_input_text" />

                    <!-- Nút xác nhận 36×36 (Figma 282:83): trắng viền cam, dấu ✓ cam -->
                    <ImageButton
                        android:id="@+id/btn_text_done"
                        android:layout_width="@dimen/editor_text_input_h"
                        android:layout_height="@dimen/editor_text_input_h"
                        android:layout_marginStart="@dimen/grid_gap"
                        android:background="@drawable/bg_text_input"
                        android:contentDescription="@string/cd_confirm"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_check" />
                </LinearLayout>

                <!-- Hàng font + màu chữ (Text 2:1456 / 2:1479 cách nhau 16; Speech 282:43 / 282:66 cách nhau 8,
                     khoảng cách đổi theo tab trong Fragment) -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_fonts"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/editor_chip"
                    android:layout_marginBottom="@dimen/editor_fonts_bottom"
                    android:clipToPadding="false"
                    android:orientation="horizontal"
                    android:overScrollMode="never"
                    android:paddingHorizontal="@dimen/part_grid_padding_h"
                    android:visibility="gone"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tools:listitem="@layout/item_font_chip" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_text_colors"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/editor_chip"
                    android:clipToPadding="false"
                    android:orientation="horizontal"
                    android:overScrollMode="never"
                    android:paddingHorizontal="@dimen/part_grid_padding_h"
                    android:visibility="gone"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tools:listitem="@layout/item_color_chip" />

                <!-- Lưới 5 cột ô 56×56 (Figma 2:1195) -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_grid"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:clipToPadding="false"
                    android:overScrollMode="never"
                    android:paddingHorizontal="@dimen/part_grid_padding_h"
                    android:paddingBottom="@dimen/grid_gap"
                    tools:listitem="@layout/item_decor_cell" />
            </LinearLayout>

            <!-- Tab chính: Background / Sticker / Speech / Text (Figma 2:1227) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/editor_nav_h"
                android:background="@color/tab_bar_bg"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/tab_background"
                    style="@style/Widget.ST260ChibiOCMaker.EditorTab"
                    android:contentDescription="@string/cd_tab_background"
                    android:src="@drawable/ic_tab_background" />

                <ImageView
                    android:id="@+id/tab_sticker"
                    style="@style/Widget.ST260ChibiOCMaker.EditorTab"
                    android:layout_marginStart="@dimen/editor_nav_gap"
                    android:contentDescription="@string/cd_tab_sticker"
                    android:src="@drawable/ic_tab_sticker" />

                <ImageView
                    android:id="@+id/tab_speech"
                    style="@style/Widget.ST260ChibiOCMaker.EditorTab"
                    android:layout_marginStart="@dimen/editor_nav_gap"
                    android:contentDescription="@string/cd_tab_speech"
                    android:src="@drawable/ic_tab_speech" />

                <ImageView
                    android:id="@+id/tab_text"
                    style="@style/Widget.ST260ChibiOCMaker.EditorTab"
                    android:layout_marginStart="@dimen/editor_nav_gap"
                    android:contentDescription="@string/cd_tab_text"
                    android:src="@drawable/ic_tab_text" />
            </LinearLayout>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.chibi.dream.cute.core.widget.ShimmerFrameLayout>
