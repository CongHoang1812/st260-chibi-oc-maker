<?xml version="1.0" encoding="utf-8"?>
<!-- Thẻ template (Figma 2:463): ô trắng 160 bo 4, ảnh nhân vật phủ kín.
     Chờ API: ô ảnh chạy shimmer (com.facebook.shimmer); thẻ vẫn bấm được. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="@dimen/template_item_w"
    android:layout_height="@dimen/template_item_w"
    android:background="@drawable/bg_template_item"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <com.facebook.shimmer.ShimmerFrameLayout
        android:id="@+id/shimmer"
        style="@style/Widget.ST260ChibiOCMaker.Shimmer"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Khối skeleton: màu do shimmer tô lại (chế độ colored) -->
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_template_item" />
    </com.facebook.shimmer.ShimmerFrameLayout>

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/iv_thumbnail"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:visibility="invisible"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.ST260ChibiOCMaker.DecorItem"
        tools:ignore="ContentDescription" />
</FrameLayout>
