<?xml version="1.0" encoding="utf-8"?>
<!-- Splash (Figma 2:1091): nền cam đất, ảnh minh hoạ 360×570 mờ hai đầu, logo CHIBI OC MAKER phía trên,
     vòng loading xoay + dòng "This action can contain ads" ở đáy (Figma 282:18). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_splash">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/iv_splash"
            android:layout_width="0dp"
            android:layout_height="@dimen/splash_image_h"
            android:layout_marginTop="@dimen/splash_image_top"
            android:foreground="@drawable/bg_splash_image_fade"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop"
            android:src="@drawable/img_splash"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Logo dùng chung với Home (Figma 2:1093 trùng ảnh 21:29) -->
        <ImageView
            android:id="@+id/iv_logo"
            android:layout_width="0dp"
            android:layout_height="@dimen/splash_logo_h"
            android:layout_marginTop="@dimen/splash_logo_top"
            android:contentDescription="@string/app_title"
            android:scaleType="fitCenter"
            android:src="@drawable/img_logo"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_ads"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/splash_bottom_margin"
            android:gravity="center"
            android:padding="@dimen/splash_ads_padding"
            android:text="@string/splash_ads_notice"
            android:textAppearance="@style/Text.SplashInfo"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <ImageView
            android:id="@+id/iv_spinner"
            android:layout_width="@dimen/splash_spinner"
            android:layout_height="@dimen/splash_spinner"
            android:contentDescription="@string/loading"
            android:src="@drawable/ic_splash_spinner"
            app:layout_constraintBottom_toTopOf="@id/tv_ads"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
