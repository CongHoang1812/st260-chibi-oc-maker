<?xml version="1.0" encoding="utf-8"?>
<!-- Lucky roll (Figma 2:155 mặc định / 2:169 sau khi Random): ô vuông rộng hết màn, Random 328 có xúc xắc -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_tavern">

    <com.conght.chibiocmaker.core.widget.ShimmerFrameLayout
        android:id="@+id/shimmer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:shimmerAutoStart="false"
        app:shimmerTone="light">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageButton
                android:id="@+id/btn_back"
                style="@style/Widget.ST260ChibiOCMaker.ImageIconButton"
                android:layout_marginStart="@dimen/screen_padding"
                android:layout_marginTop="@dimen/top_bar_top"
                android:contentDescription="@string/cd_back"
                android:src="@drawable/ic_back"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <com.conght.chibiocmaker.core.widget.WoodButton
                android:id="@+id/btn_edit"
                style="@style/Widget.ST260ChibiOCMaker.WoodButton"
                android:layout_marginEnd="@dimen/screen_padding"
                android:layout_marginTop="@dimen/top_bar_top"
                android:text="@string/edit"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:visibility="visible" />

            <!-- Vùng neo luôn còn kích thước: idle_box bị GONE sau khi Random nên không neo error_state vào đó được -->
            <Space
                android:id="@+id/result_area"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginTop="@dimen/lucky_content_top"
                app:layout_constraintDimensionRatio="1:1"
                app:layout_constraintWidth_max="@dimen/success_image_max"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Idle: khung xám + hướng dẫn + mũi tên xoắn chỉ xuống nút Random -->
            <FrameLayout
                android:id="@+id/idle_box"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:background="@drawable/bg_lucky_idle"
                app:layout_constraintEnd_toEndOf="@id/result_area"
                app:layout_constraintStart_toStartOf="@id/result_area"
                app:layout_constraintTop_toTopOf="@id/result_area"
                app:layout_constraintBottom_toBottomOf="@id/result_area">

                <TextView
                    android:layout_width="@dimen/lucky_hint_w"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="@dimen/lucky_hint_top"
                    android:gravity="center"
                    android:text="@string/lucky_roll_hint"
                    android:textAppearance="@style/Text.Body.White" />

                <ImageView
                    android:layout_width="@dimen/lucky_arrow_w"
                    android:layout_height="@dimen/lucky_arrow_h"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="@dimen/lucky_arrow_top"
                    android:importantForAccessibility="no"
                    android:src="@drawable/img_lucky_arrow" />
            </FrameLayout>

            <!-- Loading: skeleton cùng kích thước -->
            <include
                android:id="@+id/result_skeleton"
                layout="@layout/view_skeleton_image"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="@id/result_area"
                app:layout_constraintStart_toStartOf="@id/result_area"
                app:layout_constraintTop_toTopOf="@id/result_area"
                app:layout_constraintBottom_toBottomOf="@id/result_area" />

            <!-- Kết quả: ảnh nhân vật nền trắng (Figma 2:170) -->
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/iv_result"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:background="@color/white"
                android:contentDescription="@string/cd_result_image"
                android:scaleType="fitCenter"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="@id/result_area"
                app:layout_constraintStart_toStartOf="@id/result_area"
                app:layout_constraintTop_toTopOf="@id/result_area"
                app:layout_constraintBottom_toBottomOf="@id/result_area"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.ST260ChibiOCMaker.DecorItem" />

            <com.conght.chibiocmaker.core.widget.ErrorStateView
                android:id="@+id/error_state"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="@id/result_area"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/result_area" />

            <!-- Random 328 có xúc xắc, cách ô 24 (Figma 2:164) -->
            <com.conght.chibiocmaker.core.widget.WoodButton
                android:id="@+id/btn_random"
                style="@style/Widget.ST260ChibiOCMaker.RandomButton"
                android:layout_marginTop="@dimen/success_download_top"
                android:text="@string/random"
                app:buttonWidth="@dimen/success_download_w"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/result_area" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.conght.chibiocmaker.core.widget.ShimmerFrameLayout>
</FrameLayout>
