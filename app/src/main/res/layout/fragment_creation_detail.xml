<?xml version="1.0" encoding="utf-8"?>
<!-- Chi tiết creation (Figma Character 2:1746, Design 2:1775): như Successful Maker, ảnh vuông trắng rộng hết màn
     trên nền gradient chung, nút Edit rộng 328 (chỉ Character). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_tavern"
    tools:ignore="Overdraw">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageButton
            android:id="@+id/btn_back"
            style="@style/Widget.ST260ChibiOCMaker.ImageIconButton"
            android:layout_marginStart="@dimen/screen_padding"
            android:layout_marginTop="@dimen/top_bar_top"
            android:contentDescription="@string/cd_back"
            android:src="@drawable/ic_back"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageButton
            android:id="@+id/btn_download"
            style="@style/Widget.ST260ChibiOCMaker.ImageIconButton"
            android:layout_marginEnd="@dimen/screen_padding"
            android:layout_marginTop="@dimen/top_bar_top"
            android:contentDescription="@string/cd_download"
            android:src="@drawable/ic_download"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <com.conght.chibiocmaker.core.widget.RoundIconButton
            android:id="@+id/btn_share"
            android:layout_width="@dimen/icon_button_large"
            android:layout_height="@dimen/icon_button_large"
            android:layout_marginEnd="@dimen/top_bar_action_gap"
            android:contentDescription="@string/cd_share"
            app:icon="@drawable/ic_share"
            app:layout_constraintEnd_toStartOf="@id/btn_download"
            app:layout_constraintTop_toTopOf="@id/btn_download" />

        <com.conght.chibiocmaker.core.widget.RoundIconButton
            android:id="@+id/btn_delete"
            android:layout_width="@dimen/icon_button_large"
            android:layout_height="@dimen/icon_button_large"
            android:layout_marginEnd="@dimen/top_bar_action_gap"
            android:contentDescription="@string/cd_delete"
            app:icon="@drawable/ic_trash"
            app:layout_constraintEnd_toStartOf="@id/btn_share"
            app:layout_constraintTop_toTopOf="@id/btn_download" />

        <!-- Chờ ảnh: shimmer cùng vị trí/kích thước ảnh -->
        <com.facebook.shimmer.ShimmerFrameLayout
            android:id="@+id/shimmer"
            style="@style/Widget.ST260ChibiOCMaker.Shimmer"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/success_image_top"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintWidth_max="@dimen/success_image_max">

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/white" />
        </com.facebook.shimmer.ShimmerFrameLayout>

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/iv_image"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/success_image_top"
            android:background="@color/white"
            android:contentDescription="@string/cd_result_image"
            android:scaleType="fitCenter"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintWidth_max="@dimen/success_image_max" />

        <com.conght.chibiocmaker.core.widget.WoodButton
            android:id="@+id/btn_edit"
            style="@style/Widget.ST260ChibiOCMaker.WoodButton"
            android:layout_marginTop="@dimen/success_download_top"
            android:text="@string/edit"
            android:visibility="gone"
            app:buttonWidth="@dimen/success_download_w"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/iv_image"
            tools:visibility="visible" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
