<?xml version="1.0" encoding="utf-8"?>
<!-- Thẻ My creation (Figma 2:1560): ô trắng 160 bo 4, ảnh phủ kín (shimmer khi chờ ảnh).
     Nút nhỏ 24 ở 2 góc trên: xoá (trái), sửa (phải, chỉ Character); chế độ chọn: checkbox ở góc phải (2:1675). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="@dimen/creation_item_w"
    android:layout_height="@dimen/creation_item_w"
    android:background="@drawable/bg_creation_card"
    android:focusable="true">

    <!-- Chờ ảnh (chưa có / đang tải): shimmer cùng kích thước ô ảnh -->
    <com.facebook.shimmer.ShimmerFrameLayout
        android:id="@+id/shimmer"
        style="@style/Widget.ST260ChibiOCMaker.Shimmer"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_creation_card" />
    </com.facebook.shimmer.ShimmerFrameLayout>

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/iv_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white"
        android:scaleType="fitCenter"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.ST260ChibiOCMaker.DecorItem"
        tools:ignore="ContentDescription" />

    <ImageButton
        android:id="@+id/btn_delete"
        android:layout_width="@dimen/small_icon"
        android:layout_height="@dimen/small_icon"
        android:layout_gravity="top|start"
        android:layout_margin="@dimen/creation_item_action_inset"
        android:background="@drawable/bg_small_icon"
        android:contentDescription="@string/cd_delete"
        android:padding="@dimen/small_icon_padding"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_trash_card" />

    <ImageButton
        android:id="@+id/btn_edit"
        android:layout_width="@dimen/small_icon"
        android:layout_height="@dimen/small_icon"
        android:layout_gravity="top|end"
        android:layout_margin="@dimen/creation_item_action_inset"
        android:background="@drawable/bg_small_icon"
        android:contentDescription="@string/cd_edit"
        android:padding="@dimen/small_icon_padding"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_pencil" />

    <ImageView
        android:id="@+id/iv_checkbox"
        android:layout_width="@dimen/small_icon"
        android:layout_height="@dimen/small_icon"
        android:layout_gravity="top|end"
        android:layout_margin="@dimen/creation_item_action_inset"
        android:background="@drawable/bg_checkbox"
        android:importantForAccessibility="no"
        android:padding="@dimen/small_icon_padding"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_checkbox_check"
        android:visibility="gone" />
</FrameLayout>
