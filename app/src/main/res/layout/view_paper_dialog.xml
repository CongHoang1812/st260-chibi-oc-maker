<?xml version="1.0" encoding="utf-8"?>
<!-- Nội dung của PaperDialogContainer (Figma 258:18 / 258:63 / 258:106): thẻ kem + tab tiêu đề cam đè nửa lên mép trên,
     chữ canh giữa vùng cao 60, hàng nút viên 124×34 cách nhau 8.
     Nền tab tiêu đề vẽ bằng WoodButtonDrawable (không khung trắng) trong PaperDialogContainer. -->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:layout_height="wrap_content"
    tools:layout_width="@dimen/dialog_width"
    tools:parentTag="android.widget.FrameLayout">

    <LinearLayout
        android:id="@+id/panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dialog_title_tab_overlap"
        android:background="@drawable/bg_dialog_card"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="@dimen/dialog_card_padding_top"
        android:paddingBottom="@dimen/dialog_padding_bottom">

        <TextView
            android:id="@+id/tv_message"
            style="@style/Widget.ST260ChibiOCMaker.TextView.SystemFont"
            android:layout_width="@dimen/dialog_text_width"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dialog_message_top"
            android:layout_marginBottom="@dimen/dialog_message_gap"
            android:gravity="center"
            android:minHeight="@dimen/dialog_message_min_h"
            android:textAppearance="@style/Text.DialogMessage"
            tools:text="@string/dialog_exit_message" />

        <!-- Vùng tuỳ biến: nhận các view con khai báo trong <PaperDialogContainer> -->
        <FrameLayout
            android:id="@+id/content"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/dialog_content_gap"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.conght.chibiocmaker.core.widget.WoodButton
                android:id="@+id/btn_start"
                style="@style/Widget.ST260ChibiOCMaker.TabButton"
                android:text="@string/yes" />

            <com.conght.chibiocmaker.core.widget.WoodButton
                android:id="@+id/btn_end"
                style="@style/Widget.ST260ChibiOCMaker.TabButton"
                android:layout_marginStart="@dimen/dialog_button_gap"
                android:text="@string/no" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dialog_title_tab_h"
        android:layout_gravity="top|center_horizontal"
        android:gravity="center"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:minWidth="@dimen/dialog_title_tab_w"
        android:paddingHorizontal="@dimen/dialog_title_padding_h"
        android:textAppearance="@style/Text.DialogTitle.Tab"
        tools:text="@string/dialog_exit_title" />
</merge>
