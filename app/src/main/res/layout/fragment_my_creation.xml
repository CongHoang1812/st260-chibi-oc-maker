<?xml version="1.0" encoding="utf-8"?>
<!-- My creation (Figma Character: rỗng 2:1520, danh sách 2:1548, chọn nhiều 2:1656; Design: 2:1534 / 2:1614 / 2:1705).
     Nền gradient chung, thân xanh từ y 84 chứa tab Character / Design canh giữa, lưới 2 cột ô 160. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_tavern">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Thân nền xanh (Figma 2:1554) -->
        <View
            android:id="@+id/body"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/creation_body_top"
            android:background="@color/cream"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Header: Back | (chế độ chọn) Delete, Share, Download -->
        <ImageButton
            android:id="@+id/btn_back"
            style="@style/Widget.ST260ChibiOCMaker.ImageIconButton"
            android:layout_marginStart="@dimen/screen_padding"
            android:layout_marginTop="@dimen/top_bar_top"
            android:contentDescription="@string/cd_back"
            android:src="@drawable/ic_back"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageButton
            android:id="@+id/btn_download"
            style="@style/Widget.ST260ChibiOCMaker.ImageIconButton"
            android:layout_marginEnd="@dimen/screen_padding"
            android:layout_marginTop="@dimen/top_bar_top"
            android:contentDescription="@string/cd_download"
            android:src="@drawable/ic_download"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <com.conght.chibiocmaker.core.widget.RoundIconButton
            android:id="@+id/btn_share"
            android:layout_width="@dimen/icon_button_large"
            android:layout_height="@dimen/icon_button_large"
            android:layout_marginEnd="@dimen/top_bar_action_gap"
            android:contentDescription="@string/cd_share"
            android:visibility="gone"
            app:icon="@drawable/ic_share"
            app:layout_constraintEnd_toStartOf="@id/btn_download"
            app:layout_constraintTop_toTopOf="@id/btn_download" />

        <com.conght.chibiocmaker.core.widget.RoundIconButton
            android:id="@+id/btn_delete"
            android:layout_width="@dimen/icon_button_large"
            android:layout_height="@dimen/icon_button_large"
            android:layout_marginEnd="@dimen/top_bar_action_gap"
            android:contentDescription="@string/cd_delete"
            android:visibility="gone"
            app:icon="@drawable/ic_trash"
            app:layout_constraintEnd_toStartOf="@id/btn_share"
            app:layout_constraintTop_toTopOf="@id/btn_download" />

        <!-- Tab Character / Design: nút viên 124×34 canh giữa, chọn = cam, không chọn = xám (Figma 2:1555) -->
        <com.conght.chibiocmaker.core.widget.WoodButton
            android:id="@+id/tab_character"
            style="@style/Widget.ST260ChibiOCMaker.TabButton"
            android:layout_marginTop="@dimen/creation_tabs_top"
            android:text="@string/character"
            app:layout_constraintEnd_toStartOf="@id/tab_design"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/body" />

        <com.conght.chibiocmaker.core.widget.WoodButton
            android:id="@+id/tab_design"
            style="@style/Widget.ST260ChibiOCMaker.TabButton"
            android:layout_marginStart="@dimen/dialog_button_gap"
            android:text="@string/design"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/tab_character"
            app:layout_constraintTop_toTopOf="@id/tab_character" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_creations"
            android:layout_width="@dimen/creation_grid_w"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/creation_grid_top"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingBottom="@dimen/screen_padding"
            app:layout_constraintBottom_toTopOf="@id/sticker_bar"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/body"
            tools:listitem="@layout/item_creation" />

        <!-- Rỗng (Figma 2:1532 / 2:1533): ảnh 200 có bóng, chữ trắng ngay dưới -->
        <LinearLayout
            android:id="@+id/empty_state"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@id/body"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/body"
            tools:visibility="visible">

            <ImageView
                android:layout_width="@dimen/creation_empty_image"
                android:layout_height="@dimen/creation_empty_image"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop"
                android:src="@drawable/img_empty_character" />

            <TextView
                android:id="@+id/tv_empty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textAppearance="@style/Text.TabSmall"
                tools:text="@string/no_character_here" />
        </LinearLayout>

        <!-- Chế độ chọn – tab Character: thêm sticker vào Telegram / WhatsApp (Figma 2:1686 / 2:1690) -->
        <LinearLayout
            android:id="@+id/sticker_bar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingTop="@dimen/grid_gap"
            android:paddingBottom="@dimen/creation_sticker_bar_bottom"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            tools:visibility="visible">

            <com.conght.chibiocmaker.core.widget.WoodButton
                android:id="@+id/btn_telegram"
                style="@style/Widget.ST260ChibiOCMaker.StickerButton"
                android:text="@string/add_to_telegram"
                app:variant="telegram" />

            <com.conght.chibiocmaker.core.widget.WoodButton
                android:id="@+id/btn_whatsapp"
                style="@style/Widget.ST260ChibiOCMaker.StickerButton"
                android:layout_marginStart="@dimen/grid_gap"
                android:text="@string/add_to_whatsapp"
                app:variant="whatsapp" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
